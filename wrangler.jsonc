{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-multiplayer-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_ROOMS",
        "class_name": "AgentRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"],
    },
    {
      "tag": "v3",
      "deleted_classes": ["Sandbox"],
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "OPENCODE_MODE": "live",
    "OPENCODE_PROVIDER": "openrouter",
    "CLOUDFLARE_ACCOUNT_ID": "d93c650f72e597f96785abba389b0ce4",
    "OPENCODE_MODEL": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
    "OPENCODE_MODEL_ALLOWLIST": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
    "RAILWAY_ENVIRONMENT_ID": "795c1abd-ce4f-41f8-aa26-e7da9c55cc4f",
    "RAILWAY_SANDBOX_REGION": "us-west2",
    "RAILWAY_SANDBOX_IDLE_TIMEOUT_MINUTES": "120",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23li43DfrritRncWry",
  },
}
