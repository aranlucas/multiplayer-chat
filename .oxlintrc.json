{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "plugins": ["typescript", "oxc", "unicorn", "import", "react", "jsx-a11y", "promise", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "rules": {
    "eqeqeq": ["error", "always"],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": true,
        "ts-check": false
      }
    ],
    "curly": ["error", "all"],
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-preview/**",
    "node_modules/**",
    "worker-configuration.d.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": [
        "scripts/publish-preview.mjs",
        "test/client/app.test.tsx",
        "src/client/app.tsx",
        "src/client/event-display.ts",
        "src/server/agent-room-core.ts",
        "test/server/agent-room-identity.test.ts",
        "test/server/agent-room-turn.test.ts",
        "test/server/embedded-opencode.test.ts",
        "src/server/embedded-opencode.ts",
        "test/server/railway-sandbox.test.ts",
        "test/server/railway-tools.test.ts",
        "src/server/session-title.ts",
        "src/shared/protocol.ts"
      ],
      "rules": {
        "unicorn/no-useless-undefined": [
          "error",
          {
            "checkArguments": false
          }
        ]
      }
    }
  ]
}
