{
  "name": "relay-multiplayer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name multiplayer-chat vite",
    "dev:direct": "vite",
    "dev:e2e": "vite --config vite.e2e.config.ts --mode e2e --port 5176",
    "dev:preview": "VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' vite --mode relay-preview --port 5174",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' cf-vite build --preview --mode relay-preview",
    "deploy:preview": "pnpm build:preview && node scripts/publish-preview.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.26",
    "@opencode/sdk": "2.0.26",
    "hono": "^4.13.13",
    "lucide-react": "^1.53.0",
    "railway": "3.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-c82c3efb3",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@oxlint/plugins": "1.87.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.13",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "terser": "5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.10.1"
}
