{
  "name": "relay-multiplayer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --config vite.e2e.config.ts --port 5176",
    "dev:preview": "VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' vite --config vite.preview.config.ts --port 5174",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' vite build --config vite.preview.config.ts",
    "deploy:preview": "pnpm build:preview && node scripts/publish-preview.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "pnpm build && wrangler deploy --config dist/relay_multiplayer_agent/wrangler.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-dev-18683",
    "@opencode-ai/sdk": "0.0.0-dev-18683",
    "hono": "^4.13.5",
    "lucide-react": "^1.35.0",
    "railway": "3.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "terser": "5.51.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "packageManager": "pnpm@11.24.0"
}
