{
  "name": "relay-multiplayer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "dev:e2e": "vite --config vite.e2e.config.ts --mode e2e --port 5176",
    "dev:preview": "VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' vite --mode relay-preview --port 5174",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' CLOUDFLARE_PREVIEW_BUILD=true cf-vite build --mode relay-preview",
    "deploy:preview": "pnpm build:preview && node scripts/publish-preview.mjs",
    "prepare": "husky",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "cf-typegen": "cf workers types"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "@opencode/sdk": "2.2.6",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "railway": "3.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.3.1",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@e2e-dev/web": "0.15.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "1.0.0-beta.28",
    "e2e": "0.23.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "portless": "0.17.0",
    "terser": "5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
