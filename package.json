{
  "name": "relay-multiplayer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --config vite.e2e.config.ts --mode e2e --port 5176",
    "dev:preview": "VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' vite --config vite.preview.config.ts --mode relay-preview --port 5174",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_RELAY_BUILD=preview VITE_RELAY_ACCENT='#ff5ca8' vite build --config vite.preview.config.ts --mode relay-preview",
    "deploy:preview": "pnpm build:preview && node scripts/publish-preview.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18",
    "@opencode/sdk": "2.0.18",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "railway": "3.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.5",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "terser": "5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.6.0"
}
