{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src/worker.ts",
    "src/http-app.ts",
    "src/preview-worker.ts",
    "src/server",
    "src/shared",
    "scripts",
    "test/server",
    "test/shared",
    "test/scripts",
    "test/worker.test.ts",
    "test/setup-network.ts"
  ]
}
